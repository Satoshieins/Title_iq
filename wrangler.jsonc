{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "title-iq",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-31",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
