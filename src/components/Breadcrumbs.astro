---
interface Crumb { label: string; href?: string; }
const { trail } = Astro.props as { trail: Crumb[] };
const itemListElement = [{ name: "Home", item: new URL("/", Astro.site).href }, ...trail.map(item => ({ name: item.label, item: item.href ? new URL(item.href, Astro.site).href : Astro.url.href }))].map((item, index) => ({ "@type": "ListItem", position: index + 1, ...item }));
---
<nav class="crumbs" aria-label="Breadcrumb">
  <a href="/">Home</a>
  {trail.map(item => <><span aria-hidden="true">/</span>{item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}</>)}
</nav>
<script is:inline type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement })} />
