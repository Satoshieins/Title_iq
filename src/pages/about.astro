import BaseLayout from "../layouts/BaseLayout.astro"; import PageHero from "../components/PageHero.astro"; import Portrait from "../components/Portrait.astro"; import CTASection from "../components/CTASection.astro";
---
<BaseLayout title="About TitleIQ & Amy | Property Expertise New Zealand" description="Meet Amy, a Conveyancing Practitioner with more than 20 years of property, subdivision and conveyancing experience."><PageHero eyebrow="About TitleIQ" title="Specialist experience with a highly personal approach" trail={[{label:"About"}]} intro="TitleIQ was established to provide focused property expertise without the layers and formality often associated with larger professional firms." /><section class="sec bg-cream"><div class="wrap grid g2" style="gap:clamp(36px,5vw,72px);align-items:start"><Portrait /><div><span class="eyebrow">Conveyancing Practitioner</span><h2 class="h2">Meet Amy</h2><div class="rule" style="margin-bottom:24px"></div><p>Amy is a Conveyancing Practitioner with more than 20 years of experience in property law and conveyancing.</p><p>Her work includes residential and commercial transactions, property development, subdivisions, cross-lease and unit title freeholding, easements, covenants, finance and securities.</p><p>Amy has supported projects ranging from individual property transactions to complex, multi-stage developments involving more than 300 lots. Her approach is practical, detailed and highly personal.</p><p>Alongside her client work, Amy is a member of the New Zealand Society of Conveyancers' Standards Committee. She holds associate membership with the New Zealand Law Society and its Property Law Section and is currently completing a Bachelor of Business in Property through Massey University.</p><div class="chips">{["Conveyancing Practitioner","20+ years' experience","NZ Society of Conveyancers Standards Committee","Associate Member, New Zealand Law Society","Property Law Section"].map(c=><span class="chip">{c}</span>)}</div></div></div></section><CTASection title="Talk to Amy directly" copy="Every enquiry is reviewed personally. Tell us what you are working on and we will explain how we may be able to help." primary={{label:"Contact Amy",href:"/contact/"}} secondary={{label:"Explore Our Services",href:"/services/"}} /></BaseLayout>
