---
import BaseLayout from "../../layouts/BaseLayout.astro"; import PageHero from "../../components/PageHero.astro"; import CTASection from "../../components/CTASection.astro";
const groups=[["Subdivision services",["Residential subdivisions","Rural and lifestyle subdivisions","Horticultural and viticultural land","Boundary adjustments","Staged developments","Multi-title projects"]],["Property structures",["Cross-lease freeholding","Unit title freeholding","Easements","Land covenants","Encumbrances","Owners' associations","Shared infrastructure arrangements"]],["Project support",["Due diligence and structure","Consultant coordination","Consent and title requirements","Documentation strategy","Staging and settlement planning","Tailored fee proposals"]]] as const;
---
<BaseLayout title="Property Development & Subdivisions | TitleIQ" description="Specialist legal support for subdivisions, boundary adjustments, freeholding, easements, covenants and staged developments throughout New Zealand."><PageHero eyebrow="Development & Subdivisions" title="Specialist legal support for complex property projects" trail={[{label:"Services",href:"/services/"},{label:"Property Development & Subdivisions"}]} intro="From boundary adjustments to multi-stage residential developments, TitleIQ provides experienced legal support throughout the subdivision and development process."><div class="btns" style="margin-top:28px"><a class="btn btn-copper" href="/contact/">Discuss Your Project</a></div></PageHero><section class="sec bg-cream"><div class="wrap grid g3">{groups.map(([title,items])=><div class="card rise"><h2 class="h3">{title}</h2><ul class="ticks">{items.map(item=><li>{item}</li>)}</ul></div>)}</div></section><section class="sec bg-navy"><div class="wrap narrow"><span class="eyebrow">Experience at scale</span><h2 class="h2">From individual sites to staged developments</h2><p class="lead">TitleIQ has experience supporting projects ranging from simple boundary adjustments to multi-stage developments involving more than 300 lots. Early legal input helps reduce avoidable delays and align the project team.</p></div></section><CTASection title="Plan the legal work early" copy="Tell us about the site, proposed structure and project timing. We can identify the likely legal work and prepare a tailored fee proposal." /></BaseLayout>
