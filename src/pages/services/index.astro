---
import BaseLayout from "../../layouts/BaseLayout.astro"; import PageHero from "../../components/PageHero.astro"; import ServiceCard from "../../components/ServiceCard.astro"; import CTASection from "../../components/CTASection.astro"; import {services} from "../../data/services";
---
<BaseLayout title="Property Services | TitleIQ & Consultancy" description="Conveyancing, property development and subdivision support, and remote legal support for law firms, developers and finance companies across New Zealand."><PageHero eyebrow="Our Services" title="Property services shaped around your needs" trail={[{label:"Services"}]} intro="TitleIQ assists private clients, property professionals, developers, law firms and finance companies with a focused range of property and consultancy services."><div class="btns" style="margin-top:28px"><a class="btn btn-copper" href="/contact/">Make an Enquiry</a></div></PageHero><section class="sec bg-cream"><div class="wrap grid g3">{services.map((service,index)=><ServiceCard {service} {index} />)}</div></section><CTASection title="Tell us about your matter" copy="Send a short outline of what you need and we will explain how we may be able to assist, along with an indication of fees." secondary={{label:"View Fees",href:"/fees/"}} /></BaseLayout>
