---
import BaseLayout from "../../layouts/BaseLayout.astro"; import PageHero from "../../components/PageHero.astro"; import CTASection from "../../components/CTASection.astro";
const audiences=[["Law firms",["Additional capacity during busy periods","Document drafting and review","Leasing and property support","Policy and procedure work"]],["Property developers",["Project documentation","Easements, covenants and structures","Consultant and stakeholder coordination","One-off or ongoing assistance"]],["Finance companies",["Finance and security documentation","Operational policies and procedures","Property-related documentation","Project-based support"]]] as const;
---
<BaseLayout title="Remote Legal Support | TitleIQ & Consultancy" description="Flexible remote legal and operational support for New Zealand law firms, property developers and finance companies."><PageHero eyebrow="Remote Legal Support" title="Experienced support when you need extra capacity" trail={[{label:"Services",href:"/services/"},{label:"Remote Legal Support"}]} intro="TitleIQ provides flexible legal and operational assistance for law firms, property developers and finance companies, available for one-off assignments or ongoing support."><div class="btns" style="margin-top:28px"><a class="btn btn-copper" href="/contact/">Discuss Your Requirements</a></div></PageHero><section class="sec bg-cream"><div class="wrap grid g3">{audiences.map(([title,items])=><div class="card rise"><h2 class="h3">{title}</h2><ul class="ticks">{items.map(item=><li>{item}</li>)}</ul></div>)}</div></section><CTASection title="Add experienced capacity to your team" copy="Tell us about the work, timing and level of support required. We can discuss a practical arrangement shaped around your project or workflow." /></BaseLayout>
