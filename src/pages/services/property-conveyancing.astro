---
import BaseLayout from "../../layouts/BaseLayout.astro"; import PageHero from "../../components/PageHero.astro"; import CTASection from "../../components/CTASection.astro"; import {site} from "../../data/site";
const groups=[["Buying property",["Agreement review","Due diligence coordination","Title review","Finance and mortgage documentation","KiwiSaver and first-home support where applicable","Settlement coordination"]],["Selling property",["Agreement preparation or review","Title and ownership checks","Mortgage discharge","Settlement documentation","Coordination with agents, banks and other advisers"]],["Refinancing",["New finance documentation","Mortgage discharge and registration","Coordination with existing and incoming lenders","Trust, company and unit title requirements"]],["Commercial property and business matters",["Commercial purchases and sales","Selected business acquisitions","Leasing-related support","Finance and security documentation"]]] as const;
---
<BaseLayout title="Property Conveyancing | TitleIQ & Consultancy" description="Experienced conveyancing support for residential and commercial purchases, sales and refinancing in Hastings, Hawke's Bay and throughout New Zealand."><PageHero eyebrow="Property Conveyancing" title="Clear advice for confident property decisions" trail={[{label:"Services",href:"/services/"},{label:"Property Conveyancing"}]} intro="Whether you are buying, selling or refinancing, TitleIQ provides practical guidance and careful legal support from the first review through to settlement." note={site.nestNotice}><div class="btns" style="margin-top:28px"><a class="btn btn-copper" href="/contact/">Discuss Your Transaction</a></div></PageHero><section class="sec bg-cream"><div class="wrap narrow"><h2 class="h2">Conveyancing with a personal approach</h2><p class="lead">Property transactions involve strict deadlines, important financial commitments and documents that can have long-term consequences. We explain each stage clearly, identify issues early and keep you informed throughout the process.</p></div><div class="wrap grid g2" style="margin-top:36px">{groups.map(([title,items])=><div class="card rise"><h3 class="h3">{title}</h3><ul class="ticks">{items.map(item=><li>{item}</li>)}</ul></div>)}</div></section><CTASection title="Discuss your transaction" copy="Send us the property details and your expected timeframe. We will confirm what is involved and the fee before any work begins." secondary={{label:`Call ${site.phone}`,href:site.phoneHref}} /></BaseLayout>
