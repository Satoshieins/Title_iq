---
import BaseLayout from "../layouts/BaseLayout.astro"; import PageHero from "../components/PageHero.astro"; import ContactForm from "../components/ContactForm.astro"; import {site} from "../data/site";
---
<BaseLayout title="Contact TitleIQ | Property Services New Zealand" description="Contact TitleIQ & Consultancy in Hastings about conveyancing, property development, subdivisions or remote legal support. Phone 06 870 3299."><PageHero eyebrow="Contact" title="Tell us how we can help" trail={[{label:"Contact"}]} intro="Contact TitleIQ about a conveyancing matter, property development, subdivision project or remote support requirement." /><section class="sec"><div class="wrap grid contact-grid" style="grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:clamp(32px,4vw,64px);align-items:start"><div><h2 class="h3">Contact details</h2><p><strong>Phone</strong><br /><a href={site.phoneHref}>{site.phone}</a></p><p><strong>Email</strong><br /><a href={`mailto:${site.email}`}>{site.email}</a></p><p><strong>Address</strong><br />{site.address.map(line=><>{line}<br /></>)}</p><div class="note">{site.nestNotice}</div></div><ContactForm /></div></section></BaseLayout>
