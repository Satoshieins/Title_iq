---
import BaseLayout from "../layouts/BaseLayout.astro"; import PageHero from "../components/PageHero.astro"; import FeeTable from "../components/FeeTable.astro"; import FAQAccordion from "../components/FAQAccordion.astro"; import CTASection from "../components/CTASection.astro"; import {fees} from "../data/fees"; import {faqs} from "../data/faqs"; import {site} from "../data/site";
const schema={"@context":"https://schema.org","@type":"FAQPage",mainEntity:faqs.map(f=>({"@type":"Question",name:f.question,acceptedAnswer:{"@type":"Answer",text:f.answer}}))};
---
<BaseLayout title="Conveyancing Fees | TitleIQ & Consultancy" description="Indicative standard conveyancing fees for purchases, sales and refinancing, plus LINZ and other charges. Subdivision and consultancy work quoted on scope." {schema}><PageHero eyebrow="Transparent Pricing" title="Clear fees, agreed from the outset" trail={[{label:"Fees"}]} intro="Standard conveyancing fees are shown below. More complex property development, subdivision and consultancy engagements are quoted separately according to scope." note={`${site.nestNotice} ${site.feeNotice}`} /><section class="sec bg-cream"><div class="wrap"><span class="eyebrow">Indicative Standard Fees</span><h2 class="h2">Conveyancing fees, subject to matter review</h2><div class="grid g2" style="margin-top:32px">{fees.map(group=><FeeTable {group} />)}</div></div></section><section class="sec bg-creamd"><div class="wrap narrow"><span class="eyebrow">Questions</span><h2 class="h2">Fee questions, answered</h2><FAQAccordion items={faqs} /></div></section><CTASection title="Not sure which fee applies?" copy="Send a short description of your matter and we will confirm the likely fee, disbursements and timing before any work begins." secondary={{label:`Call ${site.phone}`,href:site.phoneHref}} /></BaseLayout>
