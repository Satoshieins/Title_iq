---
import BaseLayout from "../layouts/BaseLayout.astro";
import Portrait from "../components/Portrait.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ServiceCard from "../components/ServiceCard.astro";
import CTASection from "../components/CTASection.astro";
import { services } from "../data/services";
import { site } from "../data/site";
const title="TitleIQ & Consultancy | Property Conveyancing & Subdivisions NZ";
const description="Tailored property conveyancing, subdivision and remote legal support for clients, developers, law firms and finance companies across New Zealand.";
const schema={"@context":"https://schema.org","@type":["ProfessionalService","LocalBusiness"],name:site.name,url:"https://titleiq.nz",telephone:"+64 6 870 3299",email:site.email,address:{"@type":"PostalAddress",streetAddress:site.address[0],addressLocality:"Hastings",addressCountry:"NZ"}};
---
<BaseLayout {title} {description} {schema}>
<section class="sec bg-cream"><div class="wrap grid g2" style="gap:clamp(36px,5vw,72px);align-items:center"><div><span class="eyebrow">New Zealand Property Law</span><h1 class="h1">Property expertise.<br />Personal guidance.</h1><p class="lead" style="margin-top:20px">Tailored conveyancing and legal support for every stage of your property journey.</p><div class="rule" style="margin:24px 0"></div><p style="color:var(--text-muted);max-width:520px">TitleIQ provides practical, experienced support to property owners, purchasers, developers, law firms and finance companies throughout New Zealand. From straightforward conveyancing to complex multi-stage subdivisions, we make the legal process clear, considered and manageable.</p><div class="btns" style="margin-top:30px"><a class="btn btn-copper" href="/contact/">Discuss Your Matter</a><a class="btn btn-ghost" href="/services/">Explore Our Services</a></div></div><div style="padding-right:18px"><Portrait loading="eager" fetchpriority="high" /></div></div></section>
<section class="sec-tight bg-creamd"><div class="wrap"><div class="stats">{[["20+","Years","Property law and conveyancing experience"],["300+","Lots subdivided","Across small to large-scale developments"],["3","Specialist areas","Conveyancing, subdivisions and remote support"]].map(([n,l,d])=><div class="stat"><div class="stat-n">{n}</div><div class="stat-l">{l}</div><div class="stat-d">{d}</div></div>)}</div></div></section>
<section class="sec bg-white"><div class="wrap narrow"><SectionHeading eyebrow="Our Approach" title="Specialist knowledge, delivered personally" intro="Property matters often involve more than documents and deadlines. They require clear communication, careful coordination and an understanding of the wider commercial objective. TitleIQ combines specialist property knowledge with direct, personal service, helping clients move forward with confidence." /><a class="tlink" href="/about/">Learn more about TitleIQ →</a></div></section>
<section class="sec bg-cream"><div class="wrap"><SectionHeading eyebrow="Our Services" title="Practical support for property matters of every scale" /><div class="grid g3">{services.map((service,index)=><ServiceCard {service} {index} />)}</div></div></section>
<section class="sec bg-navy"><div class="wrap narrow"><span class="eyebrow">Specialist Capability</span><h2 class="h2">Property development and subdivisions</h2><div class="rule" style="margin:20px 0 24px"></div><p>TitleIQ assists with subdivisions of varying size and complexity, from boundary adjustments and small residential projects through to staged developments involving hundreds of lots.</p><p>Our specialist experience allows us to identify requirements early, coordinate documentation efficiently and provide a tailored fee proposal before work begins.</p><div class="btns" style="margin-top:30px"><a class="btn btn-copper" href="/contact/">Discuss a Development</a><a class="btn btn-ghost" href="/services/property-development-subdivisions/">Learn More</a></div></div></section>
<CTASection eyebrow="Transparent Pricing" title="Let's make your next step clearer" copy="Standard conveyancing fees are published online, while subdivision and consultancy work is quoted according to scope. Tell us about your property transaction, development or support requirements and we will explain how we may be able to assist." primary={{label:"Make an Enquiry",href:"/contact/"}} secondary={{label:"View Our Fee Schedule",href:"/fees/"}} />
</BaseLayout>
