---
import LegalPageLayout from "../layouts/LegalPageLayout.astro";
const sections=[["Information collected","We collect personal information that is necessary to respond to enquiries and to provide our services. This may include your name, contact details, organisation, property or project details and information relevant to the matter."],["Contact form submissions","Information submitted through the enquiry form is used to respond to your enquiry. Sending an enquiry does not create a client relationship or confirm that TitleIQ can act in the matter. Please do not submit confidential documents through the form."],["Website analytics","If website analytics are used, they will be configured to collect aggregate usage information only. Details will be recorded here before launch."],["Cookies","The website uses only those cookies necessary for it to function correctly. Any additional cookies will be disclosed here before launch."],["How information is used","Personal information is used to respond to enquiries, provide and administer services, meet professional and legal obligations and maintain our records."],["Information storage and security","We take reasonable steps to protect personal information from loss, unauthorised access, use, modification or disclosure."],["Access and correction","You may request access to, and correction of, the personal information we hold about you."],["Policy updates","This policy may be updated from time to time. The current version will always appear on this page."]] as const;
// TODO: Obtain legal review and confirm the analytics position before launch.
---
<LegalPageLayout title="Privacy Policy | TitleIQ & Consultancy" description="How TitleIQ & Consultancy collects, uses, stores and protects personal information." intro="This page explains how TitleIQ & Consultancy collects, uses, stores and protects personal information. It is provided for general information and is not legal advice.">{sections.map(([heading,copy])=><section style="margin-bottom:34px"><h2 class="h4">{heading}</h2><p>{copy}</p></section>)}</LegalPageLayout>
